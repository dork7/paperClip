# ---- Paperclip secrets (setup.sh fills these in; never change them later) ----
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# ---- Claude Code: subscription token ----
# On your laptop run:  claude setup-token   and paste the token here.
# Do NOT also set ANTHROPIC_API_KEY, or Claude Code will bill the API instead.
CLAUDE_CODE_OAUTH_TOKEN=

# ---- Codex: ChatGPT subscription login ----
# No variable needed. Log in once after first start (see README).

# ---- Address other devices use (setup.sh detects your LAN IP) ----
PAPERCLIP_PUBLIC_URL=

# ---- Folders agents can access (absolute paths; setup.sh defaults to ~/<name>) ----
OBSIDIAN_DIR=
REPOS_DIR=
MISC_DIR=

# ---- Resource limits (setup.sh calculates: 40% cores, 20% memory) ----
PAPERCLIP_CPUS=
PAPERCLIP_MEM=
